<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:FbStudio.App.Resources"
             xmlns:vm="using:FbStudio.App.ViewModels"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="FbStudio.App.Views.AreasTabView"
             x:DataType="vm:AreasTabViewModel"
             IsVisible="{Binding IsSelected}">

  <UserControl.Styles>
    <Style Selector="Button.tool">
      <Setter Property="Padding" Value="8,4" />
    </Style>
    <Style Selector="Button.tool > StackPanel">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Spacing" Value="6" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,2" />
    </Style>
    <Style Selector="ListBox#PreviewList ListBoxItem">
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
  </UserControl.Styles>

  <DockPanel Margin="8,8,8,4">
    <!-- Acciones -->
    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <Button Classes="tool" Command="{Binding NewAreaCommand}" Margin="0,0,6,0">
        <StackPanel><mi:MaterialIcon Kind="Plus" Width="16" Height="16" /><TextBlock Text="{x:Static res:Strings.AreasNew}" /></StackPanel>
      </Button>
      <Button Classes="tool" Command="{Binding DeleteAreaCommand}" Margin="0,0,6,0">
        <StackPanel><mi:MaterialIcon Kind="Minus" Width="16" Height="16" /><TextBlock Text="{x:Static res:Strings.AreasDelete}" /></StackPanel>
      </Button>
      <Button Classes="tool" Command="{Binding SuggestCommand}" ToolTip.Tip="{x:Static res:Strings.AreasSuggestTip}" Margin="0,0,14,0">
        <StackPanel><mi:MaterialIcon Kind="AutoFix" Width="16" Height="16" /><TextBlock Text="{x:Static res:Strings.AreasSuggest}" /></StackPanel>
      </Button>
      <Button Classes="tool" Command="{Binding OpenDiagramCommand}" ToolTip.Tip="{x:Static res:Strings.AreasDiagramTip}" Margin="0,0,14,0">
        <StackPanel><mi:MaterialIcon Kind="Sitemap" Width="16" Height="16" /><TextBlock Text="{x:Static res:Strings.AreasDiagram}" /></StackPanel>
      </Button>
      <Button Classes="tool" Command="{Binding ReloadAreasCommand}" Margin="0,0,6,0">
        <StackPanel><mi:MaterialIcon Kind="Refresh" Width="16" Height="16" /><TextBlock Text="{x:Static res:Strings.AreasReload}" /></StackPanel>
      </Button>
      <Button x:Name="SaveButton" Classes="accent" Command="{Binding SaveCommand}" Margin="0,0,14,0">
        <StackPanel Orientation="Horizontal" Spacing="6"><mi:MaterialIcon Kind="ContentSave" /><TextBlock Text="{x:Static res:Strings.AreasSave}" /></StackPanel>
      </Button>
      <TextBlock Text="{x:Static res:Strings.AreasHelp}" Opacity="0.6" VerticalAlignment="Center" TextWrapping="Wrap" />
    </WrapPanel>

    <!-- El archivo: el de esta PC o uno compartido -->
    <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
        <Button x:Name="UseFileButton" Classes="tool" Content="{x:Static res:Strings.AreasUseFile}" />
        <Button x:Name="SaveAsButton" Classes="tool" Content="{x:Static res:Strings.AreasSaveAs}" />
        <Button Classes="tool" Command="{Binding UseOwnFileCommand}" IsVisible="{Binding IsSharedFile}" Content="{x:Static res:Strings.AreasUseOwnFile}" />
      </StackPanel>
      <DockPanel VerticalAlignment="Center" Margin="0,0,10,0">
        <mi:MaterialIcon DockPanel.Dock="Left" Kind="FolderNetworkOutline" Width="16" Height="16" Margin="0,0,6,0" IsVisible="{Binding IsSharedFile}" />
        <mi:MaterialIcon DockPanel.Dock="Left" Kind="FileOutline" Width="16" Height="16" Margin="0,0,6,0" IsVisible="{Binding !IsSharedFile}" />
        <TextBlock DockPanel.Dock="Left" Text="{Binding FileLabel}" Opacity="0.75" VerticalAlignment="Center" Margin="0,0,6,0" />
        <TextBlock Text="{Binding FileLocation}" Opacity="0.75" TextTrimming="PrefixCharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding FileLocation}" />
      </DockPanel>
    </DockPanel>

    <Grid ColumnDefinitions="290,6,*">
      <!-- Las áreas -->
      <Border BorderThickness="1" BorderBrush="{DynamicResource SemiColorBorder}" CornerRadius="4">
        <ListBox x:Name="AreaList" ItemsSource="{Binding Areas}" SelectedItem="{Binding SelectedArea}" Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:AreaItem">
              <DockPanel Margin="0,1">
                <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Opacity="0.6" VerticalAlignment="Center" Margin="8,0,0,0" />
                <mi:MaterialIcon DockPanel.Dock="Left" Kind="{Binding Icon}" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"
                                 Classes.custom="{Binding HasIconBrush}" />
                <StackPanel>
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Subtitle}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>
      <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="Transparent" />

      <!-- El área elegida: sus reglas y lo que junta -->
      <Panel Grid.Column="2">
        <TextBlock Text="{x:Static res:Strings.AreasPickArea}" IsVisible="{Binding !HasSelection}" Opacity="0.7" Margin="12" TextWrapping="Wrap" />
        <DockPanel IsVisible="{Binding HasSelection}">
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,10,*" RowDefinitions="Auto,8,Auto,6,Auto" IsVisible="{Binding HasEditableArea}" Margin="0,0,0,8">
            <StackPanel>
              <TextBlock Classes="label" Text="{x:Static res:Strings.AreasName}" />
              <TextBox x:Name="NameBox" Text="{Binding AreaName}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Classes="label" Text="{x:Static res:Strings.AreasDescription}" />
              <TextBox Text="{Binding AreaDescription}" />
            </StackPanel>
            <StackPanel Grid.Row="2">
              <TextBlock Classes="label" Text="{x:Static res:Strings.AreasRules}" />
              <TextBox x:Name="RulesBox" Text="{Binding RulesText}" AcceptsReturn="True" Height="110" TextWrapping="NoWrap"
                       FontFamily="Cascadia Mono,Consolas,Menlo,monospace" FontSize="12" VerticalContentAlignment="Top" />
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="2">
              <TextBlock Classes="label" Text="{x:Static res:Strings.AreasExclude}" />
              <TextBox Text="{Binding ExcludeText}" AcceptsReturn="True" Height="110" TextWrapping="NoWrap"
                       FontFamily="Cascadia Mono,Consolas,Menlo,monospace" FontSize="12" VerticalContentAlignment="Top" />
            </StackPanel>
            <CheckBox Grid.Row="4" IsChecked="{Binding IncludeDependents}"
                      ToolTip.Tip="{x:Static res:Strings.AreasIncludeDependentsTip}">
              <TextBlock Text="{x:Static res:Strings.AreasIncludeDependents}" TextWrapping="Wrap" />
            </CheckBox>
            <StackPanel Grid.Row="4" Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock Text="{x:Static res:Strings.AreasColor}" VerticalAlignment="Center" />
              <ComboBox x:Name="ColorBox" ItemsSource="{Binding AreaColors}" SelectedItem="{Binding AreaColor}" MinWidth="170">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ColorChoice">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Border Width="14" Height="14" CornerRadius="3" Background="{Binding Brush}" BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1" />
                      <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                    </StackPanel>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
          </Grid>
          <TextBlock DockPanel.Dock="Top" Text="{x:Static res:Strings.AreasUnassignedHelp}" IsVisible="{Binding !HasEditableArea}"
                     Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,8" />

          <!-- El resumen en su propio renglón: con muchos tipos no entra al lado del filtro -->
          <TextBlock DockPanel.Dock="Top" Text="{Binding PreviewSummary}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6" />
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding KindChoices}" SelectedIndex="{Binding KindIndex}" MinWidth="150" Margin="6,0,0,0" />
            <TextBox Text="{Binding PreviewFilter}" PlaceholderText="{x:Static res:Strings.AreasFilter}" />
          </DockPanel>

          <Border BorderThickness="1" BorderBrush="{DynamicResource SemiColorBorder}" CornerRadius="4">
            <ListBox x:Name="PreviewList" ItemsSource="{Binding Preview}" SelectionMode="Multiple" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:AreaObjectRow">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <mi:MaterialIcon Kind="{Binding Icon}" Width="15" Height="15" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding KindText}" Opacity="0.55" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Detail}" Opacity="0.55" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding UseText}" FontStyle="Italic" Opacity="0.6" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding AlsoIn}" Foreground="{DynamicResource FbsAccentBrush}" FontSize="12" VerticalAlignment="Center" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>
        </DockPanel>
      </Panel>
    </Grid>
  </DockPanel>
</UserControl>
